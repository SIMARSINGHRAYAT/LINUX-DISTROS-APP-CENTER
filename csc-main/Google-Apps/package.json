{
  "name": "google-apps-desktop",
  "version": "1.0.0",
  "description": "Unofficial Google Apps desktop hub for Linux.",
  "main": "src/main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "validate": "node --check src/main.js && node --check src/preload.js",
    "build:linux": "electron-builder --linux AppImage deb"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.0.12"
  },
  "engines": { "node": ">=22.12.0" },
  "build": {
    "appId": "com.google.desktop.apps",
    "productName": "Google Apps",
    "asar": true,
    "directories": { "output": "dist" },
    "files": ["src/**/*", "index.html", "assets/**/*", "package.json"],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office;Network;",
      "icon": "assets/icons",
      "synopsis": "Google productivity apps desktop hub",
      "artifactName": "Google-Apps-${version}-${arch}.${ext}"
    }
  }
}
